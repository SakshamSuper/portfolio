// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String   @id @default(uuid())
  title         String
  description   String
  problem       String
  solution      String
  architecture  String
  workflow      String
  techStack     String   // Comma-separated values
  githubUrl     String?
  liveUrl       String?
  docUrl        String?
  metrics       String
  businessValue String
  futureScope   String
  lessons       String
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Certificate {
  id         String   @id @default(uuid())
  title      String
  issuer     String
  issueDate  String
  url        String?
  imageUrl   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String   // "LLM / Agentic AI", "ML / CV", "Languages", "Data & Tools", "Cloud"
  proficiency Int      @default(80)
  icon        String?
  order       Int      @default(0)
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  tags        String   // Comma-separated values
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(uuid())
  role        String
  company     String
  dateRange   String
  description String
  order       Int      @default(0)
}

model ResearchPaper {
  id            String   @id @default(uuid())
  title         String
  authors       String
  abstract      String
  url           String?
  publishedDate String
  order         Int      @default(0)
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}
